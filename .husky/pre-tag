#!/usr/bin/env bash
# Husky hook: pre-tag
# Prevents tag creation if package.json and package-lock.json versions don't match

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the tag being created
TAG_NAME="$1"

# Extract version from tag (remove 'v' prefix)
if [[ "$TAG_NAME" =~ ^v(.+)$ ]]; then
    TAG_VERSION="${BASH_REMATCH[1]}"
else
    echo -e "${RED}Error: Tag must start with 'v' (e.g., v1.0.0)${NC}"
    exit 1
fi

# Get version from package.json
PKG_VERSION=$(node -p "require('./package.json').version")

# Check if package-lock.json exists
if [[ ! -f "package-lock.json" ]]; then
    echo -e "${RED}Error: package-lock.json not found${NC}"
    echo "Run 'npm install' to generate it"
    exit 1
fi

# Get version from package-lock.json
LOCK_VERSION=$(node -p "require('./package-lock.json').version")

# Check tag version matches package.json
if [[ "$TAG_VERSION" != "$PKG_VERSION" ]]; then
    echo -e "${RED}Error: Tag version doesn't match package.json${NC}"
    echo -e "  Tag version:       ${YELLOW}$TAG_VERSION${NC}"
    echo -e "  package.json:      ${YELLOW}$PKG_VERSION${NC}"
    echo ""
    echo "Update package.json version first, then create tag v$PKG_VERSION"
    exit 1
fi

# Compare package.json and package-lock.json versions
if [[ "$PKG_VERSION" != "$LOCK_VERSION" ]]; then
    echo -e "${RED}Error: Version mismatch!${NC}"
    echo -e "  package.json:        ${YELLOW}$PKG_VERSION${NC}"
    echo -e "  package-lock.json:   ${YELLOW}$LOCK_VERSION${NC}"
    echo ""
    echo "Run 'npm install' to sync package-lock.json with package.json"
    exit 1
fi

# Check if package.json and package-lock.json are committed
PKG_STAGED=$(git diff --cached --name-only | grep -E "^(package\.json|package-lock\.json)$" || echo "")

if [[ -n "$PKG_STAGED" ]]; then
    echo -e "${RED}Error: package.json and/or package-lock.json are staged but not committed${NC}"
    echo "Commit them first before creating a tag"
    exit 1
fi

# Check for uncommitted changes to package files
PKG_DIFF=$(git diff --name-only package.json package-lock.json)

if [[ -n "$PKG_DIFF" ]]; then
    echo -e "${RED}Error: package.json and/or package-lock.json have uncommitted changes${NC}"
    echo "Commit them first with:"
    echo "  git add package.json package-lock.json"
    echo "  git commit -m 'chore: bump version to $PKG_VERSION'"
    exit 1
fi

echo -e "${GREEN}✓ Tag validation passed${NC}"
echo -e "  Creating tag: ${GREEN}$TAG_NAME${NC}"
