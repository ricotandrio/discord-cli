{
  "name": "discord-cli",
  "version": "0.0.2-beta",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "discord-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod 755 dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "setup": "npm ci && npm run build && npm install --global .",
    "pack": "npm run build && npm pack",
    "start": "node dist/cli.js",
    "prepare": "husky",
    "tag": "./scripts/pre-tag-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "typescript": "^5.7.0"
  }
}
