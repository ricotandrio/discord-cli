{
  "name": "discord-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "discord-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "setup": "npm ci && npm run build && npm install --global .",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0"
  }
}
